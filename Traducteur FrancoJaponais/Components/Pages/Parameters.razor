@page "/Parameters"
@using Traducteur_FrancoJaponais.Services
@using Traducteur_FrancoJaponais.Services.Interface
@inject IDataBaseService dataBaseService;

<h3>Parameters</h3>
<button class="btn btn-primary mt-4" @onclick="InitData">Init dataBase</button>
<button class="btn btn-primary mt-4" @onclick="BackupDb">Backup dataBase to file</button>
<button class="btn btn-primary mt-4" @onclick="RestoreDbFromFile">Restore dataBase from file</button>

@code {
    private void InitData()
    {
        dataBaseService.InitDataOnBase();
    }
    private void BackupDb()
    {
        dataBaseService.backupCoursesOnFileSystem();
    }
    private void RestoreDbFromFile()
    {

    }
}
