@page "/Dictionary"
@using DataModels.DisplayModels
@using DataModels.Model
@using DataModels.Model.Dictionary
@using Traducteur_FrancoJaponais.Constants
@using Traducteur_FrancoJaponais.Services.DataBase.Interface
@inject IDataManager<Word> WordDataManager;
@inject IDataManager<FrenchWord> FrenchWordDataManager;
@inject IDataManager<JapaneseWord> JapaneseWordDataManager;
@inject IDataManager<Tag> TagDataManager;
@inject IDataManager<WordFrench> WordFrenchDataManager;
@inject IDataManager<WordJapanese> WordJapaneseDataManager;
@inject IDataManager<WordTag> WordTagDataManager;

<h3 class="text-center bolder mt-5">Dictionary</h3>

<div class="d-flex flex-column mt-3 text-center vh-80 align-center justify-spaced">
    <div>
        <label for="latinInput">Mot : </label>
        @* <InputText id="MotInput" @bind-Value="MotInput" @oninput="OnInput"></InputText> *@
        <InputText id="MotInput" @bind-Value="MotInput"></InputText>
    </div>
    <button type="button" class="btn btn-primary" @onclick="Search">Chercher</button>
</div>

<div class="d-flex flex-column align-center justify-spaced">
    <div class="accordion" id="accordionDico">
        @foreach (DicoDisplayFrenchWord mot in Lresults)
        {
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target=@($"#collapse{mot.Id}") aria-expanded="true" aria-controls=@($"collapse{mot.Id}")>
                        @mot.French
                    </button>
                </h2>
                <div id=@($"collapse{mot.Id}") class="accordion-collapse collapse" data-bs-parent="#accordionDico">
                    <div class="accordion-body">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">
                                    @foreach (var tag in mot.Tags)
                                    {
                                        <span class="badge text-bg-primary">@tag</span>
                                    }    
                                </h5>
                                @foreach (String Japanese in mot.Japanese)
                                {
                                    <h6 class="card-subtitle mb-2 text-body-secondary">@Japanese</h6>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        </div>
</div>

@code {
    private String MotInput = String.Empty;
    List<FrenchWord> ResultatsFr = new List<FrenchWord>();
    List<DicoDisplayFrenchWord> Lresults = new List<DicoDisplayFrenchWord>();
    // private async Task OnInput(ChangeEventArgs e)
    // {
    //     MotInput = e.Value.ToString().ToLower();
    // }

    private async void Search()
    {
        Lresults = await PerformFrenchSearch();

        await InvokeAsync(StateHasChanged);
    }

    private async Task<List<DicoDisplayFrenchWord>> PerformFrenchSearch()
    {
        var ret = new List<DicoDisplayFrenchWord>();
        var db = WordDataManager.returndatabaseservice();
        ResultatsFr = db.Table<FrenchWord>().Where(f => f.Value.StartsWith(MotInput)).ToListAsync().Result.OrderBy(m => m.Value).Take(10).ToList();

        var assocFr_Word = new List<WordFrench>();//= db.Table<WordFrench>().Where(f => ResultatsFr.Select(x => x.Id).ToList().Contains(f.FId.Value)).ToListAsync().Result;
        foreach (var item in ResultatsFr)
        {
            assocFr_Word.AddRange(await db.Table<WordFrench>().Where(f => f.FId == item.Id).ToListAsync());
        }

        var words = new List<Word>();//db.Table<Word>().Where(f => assocFr_Word.Select(x => x.WId).ToList().Contains(f.Id)).ToListAsync().Result;
        foreach (var item in assocFr_Word)
        {
            words.AddRange(await db.Table<Word>().Where(f => f.Id == item.WId).ToListAsync());
        }

        var assocJp_Word = new List<WordJapanese>();//db.Table<WordJapanese>().Where(f => words.Select(x => x.Id).ToList().Contains(f.WId.Value)).ToListAsync().Result;
        foreach (var item in words)
        {
            assocJp_Word.AddRange(await db.Table<WordJapanese>().Where(f => f.WId == item.Id).ToListAsync());
        }

        var japanese = new List<JapaneseWord>();//db.Table<JapaneseWord>().Where(f => assocJp_Word.Select(x => x.JId).ToList().Contains(f.Id)).ToListAsync().Result;
        foreach (var item in assocJp_Word)
        {
            if (!japanese.Any(x => x.Id == item.JId))
            {
                japanese.AddRange(await db.Table<JapaneseWord>().Where(f => f.Id == item.JId).ToListAsync());
            }
        }

        var assocTag_Word = new List<WordTag>();//db.Table<WordTag>().Where(f => words.Select(x => x.Id).ToList().Contains(f.WId.Value)).ToListAsync().Result;
        foreach (var item in words)
        {
            assocTag_Word.AddRange(await db.Table<WordTag>().Where(f => f.WId == item.Id).ToListAsync());
        }

        var tags = new List<Tag>();//db.Table<Tag>().Where(f => assocTag_Word.Select(x => x.TId).ToList().Contains(f.Id)).ToListAsync().Result;
        foreach (var item in assocTag_Word)
        {
            if (!tags.Any(x => x.Id == item.TId))
            {
                tags.AddRange(await db.Table<Tag>().Where(f => f.Id == item.TId).ToListAsync());
            }
        }

        foreach (var item in ResultatsFr)
        {
            var word = words.FirstOrDefault(x => x.Id == assocFr_Word.FirstOrDefault(w => w.FId == item.Id).WId);
            var ljaps = japanese.FindAll(x => assocJp_Word.FindAll(w => w.WId == word.Id).Select(y => y.JId).ToList().Contains(x.Id));
            var ltags = tags.FindAll(x => assocTag_Word.FindAll(w => w.WId == word.Id).Select(y => y.TId).ToList().Contains(x.Id));
            ret.Add(new DicoDisplayFrenchWord()
            {
                Id = word.Id,
                ResearchString = word.ResearchString,
                French = item.Value,
                Japanese = ljaps.Select(j => j.Value).ToList(),
                Tags = ltags.Select(j => j.Value).ToList(),

            });
        }
        return ret;
    }
}
