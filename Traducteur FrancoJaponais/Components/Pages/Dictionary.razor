@page "/Dictionary"
@using DataModels.DisplayModels
@using DataModels.Model
@using DataModels.Model.Dictionary
@using System.Collections.ObjectModel
@using System.Collections.Specialized
@using Traducteur_FrancoJaponais.Constants
@using Traducteur_FrancoJaponais.Services
@using Traducteur_FrancoJaponais.Services.DataBase.Interface
@using Traducteur_FrancoJaponais.Components.Pages.components
@inject IDictionaryService DictionaryService;


<h3 class="text-center bolder mt-5">Dictionary</h3>

<div class="d-flex flex-column mt-3 text-center vh-80 align-center justify-spaced">
    <div>
        <label for="latinInput">Mot : </label>
        @* <InputText id="MotInput" @bind-Value="MotInput" @oninput="OnInput"></InputText> *@
        <InputText id="MotInput" @bind-Value="MotInput"></InputText>
    </div>
    <button type="button" class="btn btn-primary" @onclick="Search">Chercher<span class="ms-1 badge rounded-pill bg-danger">@Count</span></button>

    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item"><a class="page-link" @onclick="Previous">Previous</a></li>
            @foreach(int page in AllPages)
            {
                if (page == CurrentPage)
                {
                    <li class="page-item active"><a class="page-link" @onclick="(() => SkipToPage(page))">@(page)</a></li>
                }
                else
                {
                    <li class="page-item"><a class="page-link" @onclick="(() => SkipToPage(page))">@(page)</a></li>
                }
            }
            <li class="page-item"><a class="page-link" @onclick="Next">Next</a></li>
        </ul>
    </nav>

    <div class="d-flex flex-column align-center justify-spaced">
        <div class="accordion" id="accordionWord">
            @foreach (DicoDisplayFrenchWord mot in Lresults)
            {
                <DicoDisplayFrenchWordComponent Word="@mot" AccordionName="accordionWord"></DicoDisplayFrenchWordComponent>
            }
            </div>
    </div>
</div>

@code {
    private String MotInput = String.Empty;
    List<DicoDisplayFrenchWord> Lresults = new List<DicoDisplayFrenchWord>();
    public int Count = 0;
    public int PagesCount = 0;
    public int CurrentPage = 0;
    public List<int> AllPages = new List<int>();
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    private async void Search()
    {
        DictionaryService.FromFrenchResults.CollectionChanged -= OnResultsChanged;
        DictionaryService.FromFrenchResults = new ObservableCollection<DicoDisplayFrenchWord>();
        DictionaryService.FromFrenchResults.CollectionChanged += OnResultsChanged;
        Count = 0;
        CurrentPage = 1;
        AllPages = new List<int>() { 1};
        UpdateDisplay();

        DictionaryService.GetFromFrench(MotInput);
    }

    private void OnResultsChanged(object? sender, NotifyCollectionChangedEventArgs e)
    {
        Count = DictionaryService.FromFrenchResults.Count();
        PagesCount = Count % 10 == 0 ? (Count / 10) : (Count / 10) + 1;
        AllPages = new List<int>();
        for (int i = 1; i < PagesCount+1; i++)
        {
            AllPages.Add(i);
        }
        UpdateDisplay();
    }

    private void Previous()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            UpdateDisplay();
        }
    }

    private void Next()
    {
        if (CurrentPage < PagesCount)
        {
            CurrentPage++;
            UpdateDisplay();
        }
    }

    private void SkipToPage(int page)
    {
        CurrentPage = page;
        UpdateDisplay();
    }

    private void UpdateDisplay()
    {
        Lresults = DictionaryService.FromFrenchResults.ToList().Skip((CurrentPage - 1) * 10).Take(10).ToList();
        InvokeAsync(StateHasChanged);
    }
}
