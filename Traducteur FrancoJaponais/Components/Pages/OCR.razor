@page "/OCR"
@using Plugin.Maui.OCR
@using Traducteur_FrancoJaponais.Services.Interface
@inject IJSRuntime js
@inject IPermissionManager PermissionManager;
@inject IOcrService OcrService;
<h3>OCR</h3>

<button class="btn btn-primary" @onclick="Capture">Click me</button>
<img id="image" class="img-fluid" alt="OCR Image source"/>
<div>
    <span>AllText</span>
    <span>@AllText</span>
</div>


@code {
    //permissions management
    //https://learn.microsoft.com/en-us/dotnet/maui/platform-integration/appmodel/permissions?view=net-maui-10.0&tabs=windows
    //camera usage
    //https://stackoverflow.com/questions/77624261/unable-to-use-mobile-device-camera-in-blazor-maui-hybrid-application
    //OCR nugget
    //https://www.nuget.org/packages/Plugin.Maui.OCR
    //
    private string AllText = String.Empty;
    private async void Capture()
    {
        var permissionCamera = await PermissionManager.CheckAndRequestCameraPermission();
        if ( permissionCamera == PermissionStatus.Granted)
        {
            FileResult photo = null;
            if (DeviceInfo.Current.Platform == DevicePlatform.Android || DeviceInfo.Current.Platform == DevicePlatform.iOS)
            {
                var permissionWrite = await PermissionManager.CheckAndRequestWriteExternalStorage();
                if (permissionWrite == PermissionStatus.Granted)
                {
                    photo = await MediaPicker.Default.CapturePhotoAsync();//Finit dans le cache /data/user/0/com.grimonthadrien.traducteurfrajap/cache/2203693cc04e0be7f4f024d5f9499e13/636358e875444c92b10a69c899293036/7d4cf09ddb2348a1afc7f3caf2a720f0.jpg
                }
            }
            if (photo == null)
            {
                return;
            }
            else
            {
                try
                {
                    OcrResult result = await ProcessPhoto(photo);
                    if (result != null)
                    {
                        AllText = result.AllText;
                    }
                }
                catch (Exception e)
                {
                    AllText = e.Message;
                }
            }
            using (var stream = await photo.OpenReadAsync())
            {
                var dotnetImageStream = new DotNetStreamReference(stream);
                await js.InvokeAsync<bool>("captureImage", "image", dotnetImageStream);
            }
        }
    }

    /// <summary>
    /// Takes a photo and processes it using the OCR service.
    /// </summary>
    /// <param name="photo">The photo to process.</param>
    /// <returns>The OCR result.</returns>
    private async Task<OcrResult> ProcessPhoto(FileResult photo)
    {
        // Open a stream to the photo
        using var sourceStream = await photo.OpenReadAsync();

        // Create a byte array to hold the image data
        var imageData = new byte[sourceStream.Length];

        // Read the stream into the byte array
        await sourceStream.ReadAsync(imageData);

        // Process the image data using the OCR service
        return await OcrService.RecognizeTextAsync(imageData);
    }
}

