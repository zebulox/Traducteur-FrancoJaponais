@using System.Linq.Expressions
@using SQLite
@using Traducteur_FrancoJaponais.Model
@using Traducteur_FrancoJaponais.Services.DataBase.Interface
@inject IDataManager<HiromiPhrase> HiromiPhraseDataManager;
@inject IDataManager<HiromiCourse> HiromiCourseDataManager;
@inject NavigationManager _navigationManager

<div class="accordion-item">
    <h2 class="accordion-header">
        <div class="d-flex p-3">
            <button class="accordion-button collapsed" style="font-weight: bolder !important;" type="button" data-bs-toggle="collapse" data-bs-target=@($"#flush-collapse{Course.Id}") aria-expanded="false" aria-controls=@($"flush-collapse{Course.Id}")>
                #@Course.Number => @Course.Titre 
            </button>
            <div class="mt-2">
                <span class="bi bi-trash3" type="button" @onclick="DeleteCour"></span>
            </div>
        </div>
    </h2>
    <div id=@($"flush-collapse{Course.Id}") class="accordion-collapse collapse" data-bs-parent="#HiromiCourseaccordion">
        @foreach (HiromiPhrase phrase in Phrases)
        {
            <div class="accordion-body">
                <div class="card text-center">
                    <div class="card-header">
                        @(phrase.Japonais)
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">@(phrase.Francais)</h5>
                        <p class="card-text">@(phrase.Explication)</p>
                    </div>
                </div>
            </div>
        }
        <a href="@Course.Link" class="card-link">Lien vers le cours Youtube</a>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback onRefreshView { get; set; }
    [Parameter]
    public HiromiCourse Course { get; set; }
    private List<HiromiPhrase> Phrases;
    private HiromiPhrase newPhrase = new HiromiPhrase() { CourseNumber = 0, Explication = "", Francais = "", Japonais = "" };
    private String AddPhraseButtonClass = "btn btn-primary";
    private String AddPhraseButtonLabel = "Ajouter la phrase";
    private bool AddPhraseButtonDisabled = false;
    public override async Task SetParametersAsync(ParameterView parameters)
    {
        if (parameters.TryGetValue<HiromiCourse>(nameof(Course), out HiromiCourse course))
        {
            if (course != null)
            {
                try
                {
                    //TODO: trouver un fix à l'horreur ...
                    //se casse la guele comme une vielle merde sur la compilation de l'expression ?.??????
                    // Phrases = await HiromiPhraseDataManager.Get(f => f.CourseNumber == course.Id);
                    var db = HiromiPhraseDataManager.returndatabaseservice();
                    //et la ça marche .....
                    Phrases = db.Table<HiromiPhrase>().Where(f => f.CourseNumber == course.Number).ToListAsync().Result;
                }
                catch (Exception e)
                {

                }
            }
        }

        await base.SetParametersAsync(parameters);
    }

    private async Task DeleteCour()
    {
        foreach (var phrasesInCourse in Phrases)
        {
            await HiromiPhraseDataManager.Delete(phrasesInCourse);
        }
        // Phrases = new List<HiromiPhrase>();
        await HiromiCourseDataManager.Delete(Course);
        await RefreshView();
    }

    protected async Task RefreshView()
    {
        await onRefreshView.InvokeAsync();
    }
}
