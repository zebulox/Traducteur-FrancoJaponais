@using Traducteur_FrancoJaponais.Model

<div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target=@($"#flush-collapse{Course.Id}") aria-expanded="false" aria-controls=@($"flush-collapse{Course.Id}")>
            Accordion Item #@Course.Number
        </button>
    </h2>
    <div id=@($"flush-collapse{Course.Id}") class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
        <div class="accordion-body">Placeholder content for this accordion, which is intended to demonstrate the 
            <code>.accordion-flush</code> class. This is the first item’s accordion body.
        </div>
    </div>
</div>


@code {
    [Parameter]
    public HiromiCourse Course { get; set; }
}
