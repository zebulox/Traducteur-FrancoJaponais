@using DataModels.DisplayModels
@using Traducteur_FrancoJaponais.Constants

<div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target=@($"#collapse{Word.Id}") aria-expanded="true" aria-controls=@($"collapse{Word.Id}")>
            @Word.French
        </button>
    </h2>
    <div id=@($"collapse{Word.Id}") class="accordion-collapse collapse" data-bs-parent="#@AccordionName">
        <div class="accordion-body">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        @foreach (var tag in Word.Tags)
                        {
                            if (TagCss.Grammaire.Contains(tag))
                            {
                                <span class="badge text-bg-success">@tag</span>
                            }
                            else if (TagCss.Domaine.Contains(tag))
                            {
                                <span class="badge text-bg-info">@tag</span>
                            }
                            else if (TagCss.Origines.Contains(tag))
                            {
                                <span class="badge text-bg-dark">@tag</span>
                            }
                            else if (TagCss.JLPT.Contains(tag))
                            {
                                <span class="badge text-bg-primary">@tag</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">@tag</span>
                            }
                        }    
                    </h5>
                    @foreach (String Japanese in Word.Japaneses)
                    {
                        <h6 class="card-subtitle mb-2 text-body-secondary">@Japanese</h6>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public DicoDisplayFrenchWord Word { get; set; }
    [Parameter]
    public string AccordionName { get; set; }
}
