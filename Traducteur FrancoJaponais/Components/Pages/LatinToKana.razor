@page "/LatinToKana"
@using System.Text.RegularExpressions
@using System.Text
@using Traducteur_FrancoJaponais.Constants
@using Traducteur_FrancoJaponais.Services

<h3 class="text-center bolder mt-5">Traducteur Français => Japonais</h3>

<div class="d-flex flex-column mt-3 text-center vh-80 align-center justify-spaced">
    <div>
        <label for="latinInput">Latin : </label>
        <InputText id="latinInput" @bind-Value="InputText" @oninput="OnInput"></InputText>
    </div>
    <div>
        <label for="hiraganaOutput">Hiragana : </label>
        <span id="hiraganaOutput" class="fw-bolder">@HiraganaTrad</span>
    </div>
    <div>
        <button class="btn btn-primary  mx-auto" @onclick="Translate">Traduire</button>
    </div>
</div>



@code {
    String InputText = String.Empty;
    String HiraganaTrad = String.Empty;
