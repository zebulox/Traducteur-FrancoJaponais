@page "/MoneyConverter"
<h3>Convertisseur de devises</h3>

<div class="d-flex align-items-center fs-3">
    <div>
        <label for="EuroInput"><span class="bi bi-currency-euro"></span></label>
        <InputNumber id="EuroInput" @bind-Value="InputEuro" @oninput="OnInputEuro"></InputNumber>
    </div>
    <span class="p-2">&lt;=&gt;</span>
    <div>
        <label for="YenOutput"><span class="bi bi-currency-yen"></span></label>
        <span id="YenOutput" class="fw-bolder">@YenConversion</span>
    </div>
</div>
<div class="d-flex align-items-center fs-3">
    <div>
        <label for="YenInput"><span class="bi bi-currency-yen"></span></label>
        <InputNumber id="YenInput" @bind-Value="InputYen" @oninput="OnInputYen"></InputNumber>
    </div>
    <span class="p-2">&lt;=&gt;</span>
    <div>
        <label for="EuroOutput"><span class="bi bi-currency-euro"></span></label>
        <span id="EuroOutput" class="fw-bolder">@EuroConversion</span>
    </div>
</div>
@code {
    double InputEuro = 0d;
    double InputYen = 0d;
    double YenConversion = 0d;
    double EuroConversion = 0d;
    double converterRate = 180.96d;

    private void OnInputEuro(ChangeEventArgs e)
    {
        double.TryParse(e.Value.ToString(), out InputEuro);
        YenConversion = Math.Round(InputEuro * converterRate, 2);
    }
    private void OnInputYen(ChangeEventArgs e)
    {
        double.TryParse(e.Value.ToString(), out InputYen);
        EuroConversion = Math.Round(InputYen / converterRate, 2);
    }
}
