@page "/Vocabulary"
@using DataModels.DisplayModels
@using DataModels.Model
@using DataModels.Model.Dictionary
@using System.Collections.Specialized
@using System.Collections.ObjectModel
@using Traducteur_FrancoJaponais.Components.Pages.components
@using Traducteur_FrancoJaponais.Constants
@using Traducteur_FrancoJaponais.Services
@inject IDictionaryService DictionaryService;


<h3 class="text-center bolder mt-5">Vocabulary</h3>

<div class="d-flex flex-column mt-3 text-center vh-80 align-center justify-spaced">
    <select @bind="@SelectValue" class="form-select form-select-lg mb-3" aria-label="JLPT-List">
        @foreach (var item in TagCss.JLPT)
        {
            <option value="@item">@item</option>
        }
    </select>
    <select @bind="@SelectedGrammarType" class="form-select form-select-lg mb-3" aria-label="JLPT-List">
        <option value="all">Tout</option>
        @foreach (var item in TagCss.Grammaire)
        {
            <option value="@item">@item</option>
        }
    </select>
    <button type="button" class="btn btn-primary" @onclick="Search">Chercher<span class="ms-1 badge rounded-pill bg-danger">@Lresults.Count()</span></button>
</div>
<div class="d-flex flex-column mt-3 text-center vh-80 align-center justify-spaced">
    <div class="d-flex flex-column align-center justify-spaced">
        <div class="accordion" id="accordionWord">
            @foreach (DicoDisplayFrenchWord mot in Lresults)
            {
                <DicoDisplayFrenchWordComponent Word="@mot" AccordionName="accordionWord"></DicoDisplayFrenchWordComponent>
            }
            </div>
    </div>
</div>

@code {
    List<DicoDisplayFrenchWord> Lresults = new List<DicoDisplayFrenchWord>();
    Dictionary<String, List<DicoDisplayFrenchWord>> grouppedRes = new Dictionary<string, List<DicoDisplayFrenchWord>>();
    String SelectValue;
    private string _selectedGrammarType;
    string SelectedGrammarType
    {
        get
        {
            return _selectedGrammarType;
        }
        set
        {
            _selectedGrammarType = value;
            DisplayGrouppedRes();
        }
    }
    private void Search()
    {
        DictionaryService.FromFrenchResults.CollectionChanged -= OnResultsChanged;
        DictionaryService.FromFrenchResults = new ObservableCollection<DicoDisplayFrenchWord>();
        DictionaryService.FromFrenchResults.CollectionChanged += OnResultsChanged;
        grouppedRes = new Dictionary<string, List<DicoDisplayFrenchWord>>();
        UpdateDisplay();

        DictionaryService.GetFromTag(SelectValue);
    }

    private void OnResultsChanged(object? sender, NotifyCollectionChangedEventArgs e)
    {
        UpdateDisplay();
    }

    private void UpdateDisplay()
    {
        Lresults = DictionaryService.FromFrenchResults.OrderBy(w => w.French).ToList();//.Skip((CurrentPage - 1) * 10).Take(10).ToList();
        InvokeAsync(StateHasChanged);
    }
    private void DisplayGrouppedRes()
    {
        if (_selectedGrammarType == "all")
        {
            Lresults = DictionaryService.FromFrenchResults.OrderBy(w => w.French).ToList();//.Skip((CurrentPage - 1) * 10).Take(10).ToList();
            InvokeAsync(StateHasChanged);
        }
        else
        {
            Lresults = DictionaryService.FromFrenchResults.OrderBy(w => w.French).Where(w => w.Tags.Contains(_selectedGrammarType)).ToList();
            InvokeAsync(StateHasChanged);
        }
    }
}
