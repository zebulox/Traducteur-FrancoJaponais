@page "/HiromiLanguageSchool"
@using Traducteur_FrancoJaponais.Model
@using Traducteur_FrancoJaponais.Services.Interface
@using Traducteur_FrancoJaponais.Components.Pages.components
@inject IDataManager<HiromiCourse> HiromiCourseDataManager;
@inject IDataManager<HiromiPhrase> HiromiPhrasesDataManager;
@inject NavigationManager _navigationManager

<h3>Hiromi's language school</h3>
<div class="accordion accordion-flush" id="HiromiCourseaccordion">
    @* TODO Voir si on peut se passer du .Result et faire le chargement en async pur *@
    @foreach (HiromiCourse item in HiromiCourseDataManager.GetAll().Result)
    {
        <HiromiCourseComponent Course="@item" onRefreshView="Reload"></HiromiCourseComponent>
    }
    <button class="btn btn-primary mt-4" data-bs-toggle="modal" data-bs-target="#modalNvCour" @onclick="InitCreaCour">Ajouter un cour</button>
    <button class="btn btn-primary mt-4" data-bs-toggle="modal" data-bs-target="#modalNvllePhrase" @onclick="modalNvllePhrase">Ajouter une Phrase</button>
</div>

<!-- Modal nouveau cour -->
<div class="modal fade" id="modalNvCour" tabindex="-1" aria-labelledby="modalNvCourLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="modalNvCourLabel">Ajouter un cour</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label for="courTitre" class="form-label">Titre: </label>
                        <input @bind="@NewCourse.Titre" type="text" class="form-control" id="courTitre" aria-describedby="Titre">
                    </div>
                    <div class="mb-3">
                        <label for="courNumero" class="form-label">Numéro :</label>
                        <input @bind="@NewCourse.Number" type="number" class="form-control" id="courNumero">
                    </div>
                    <div class="mb-3 form-check">
                        <input @bind="@NewCourse.HorsSerie" type="checkbox" class="form-check-input" id="courIsHs">
                        <label class="form-check-label" for="courIsHs">Hors série ?</label>
                    </div>
                    <div class="mb-3">
                        <label for="courLink" class="form-label">Lien: </label>
                        <input @bind="@NewCourse.Link" type="text" class="form-control" id="courLink" aria-describedby="Lien">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                <button type="button" class="btn btn-primary" @onclick="CreateCour">Ajouter le cour</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nouvelle phrase cour -->
<div class="modal fade" id="modalNvllePhrase" tabindex="-1" aria-labelledby="modalNvllePhraseLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="modalNvllePhraseLabel">Ajouter un cour</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <select @bind="@NewPhrase.CourseNumber" class="form-select form-select-lg mb-3" aria-label="Large select example">
                            @foreach (HiromiCourse item in HiromiCourseDataManager.GetAll().Result)
                            {
                                <option value="@item.Number">@item.Titre</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="phraseLatin" class="form-label">Latin: </label>
                        <input @bind="@NewPhrase.Francais" type="text" class="form-control" id="phraseLatin" aria-describedby="Latin">
                    </div>
                    <div class="mb-3">
                        <label for="phraseJaponais" class="form-label">Japonais :</label>
                        <input @bind="@NewPhrase.Japonais" type="text" class="form-control" id="phraseJaponais">
                    </div>
                    <div class="mb-3">
                        <label for="phraseExplication" class="form-label">Explication: </label>
                        <input @bind="@NewPhrase.Explication" type="text" class="form-control" id="phraseExplication" aria-describedby="Explication">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                <button type="button" class="btn btn-primary" @onclick="CreatePhrase">Ajouter la phrase</button>
            </div>
        </div>
    </div>
</div>

@code {

    private HiromiCourse NewCourse = new HiromiCourse() { Number = 0, HorsSerie = false, Titre = String.Empty, Link = String.Empty };
    private HiromiPhrase NewPhrase = new HiromiPhrase() { CourseNumber = 0, Explication = String.Empty, Francais = String.Empty, Japonais = String.Empty };

    private void InitCreaCour()
    {
        NewCourse = new HiromiCourse() { Number = 0, HorsSerie = false, Titre = String.Empty, Link = String.Empty };
    }

    private void modalNvllePhrase()
    {
        NewPhrase = new HiromiPhrase() { CourseNumber = 0, Explication = String.Empty, Francais = String.Empty, Japonais = String.Empty };
    }

    private void CreateCour()
    {
        if (HiromiCourseDataManager.Insert(NewCourse).Result != 1)
        {
            throw new Exception("une erreur est survenue. Le cours n'a pas pu être ajouté");
        }
        else
        {
            Reload();
        }
    }

    private void CreatePhrase()
    {
        if (HiromiPhrasesDataManager.Insert(NewPhrase).Result != 1)
        {
            throw new Exception("une erreur est survenue. La phrase n'a pas pu être ajoutée");
        }
        else
        {
            Reload();
        }
    }

    void Reload()
    {
        _navigationManager.Refresh();
    }
}
